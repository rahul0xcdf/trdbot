# ── Database: Lakebase Postgres on Neon ─────────────────────────────────
# `neon deploy` (or `neon env pull`) writes both of these into .env.local.
# Pooled URL (-pooler host) — used by the app for every request.
DATABASE_URL=
# Direct URL — used only by `npm run db:migrate` for schema changes.
DATABASE_URL_UNPOOLED=
# Without DATABASE_URL, local dev keeps snapshots in ./.data instead.

# ── Ingest ───────────────────────────────────────────────────────────────
# Shared secret the Python engine sends as "Authorization: Bearer <token>".
# Set the same value as the WEB_INGEST_TOKEN GitHub secret.
INGEST_TOKEN=

# ── Optional ─────────────────────────────────────────────────────────────
# DEMO_MODE=1 serves bundled sample snapshots + synthetic prices, with a
# DEMO banner on every page. Never enable in production.
DEMO_MODE=
